[Unit]
Description=Sync the notes vault every 15 minutes

[Timer]
# First run shortly after login, then every 15 minutes.
OnStartupSec=2min
OnUnitActiveSec=15min
# Catch up after suspend or a machine that was off at the scheduled time.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
